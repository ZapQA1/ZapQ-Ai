const express = require("express");
const multer = require("multer");
const fs = require("fs");
const cors = require("cors");
const dotenv = require("dotenv");
const bodyParser = require("body-parser");

dotenv.config();
const { Configuration, OpenAIApi } = require("openai");
const { router: authRoutes, authenticateToken } = require("./auth");

const app = express();
const upload = multer({ dest: "uploads/" });

app.use(cors());
app.use(bodyParser.json());
app.use("/auth", authRoutes);

const configuration = new Configuration({
  apiKey: process.env.OPENAI_API_KEY,
});
const openai = new OpenAIApi(configuration);

app.post("/upload", authenticateToken, upload.single("image"), async (req, res) => {
  const imagePath = req.file.path;
  try {
    const base64Image = fs.readFileSync(imagePath, { encoding: "base64" });
    const response = await openai.createChatCompletion({
      model: "gpt-4-vision-preview",
      messages: [
        {
          role: "user",
          content: [
            { type: "text", text: "Please help me understand this image." },
            { type: "image_url", image_url: { url: `data:image/jpeg;base64,${base64Image}` } }
          ]
        }
      ],
      max_tokens: 300,
    });
    res.json({ response: response.data.choices[0].message.content });
  } catch (err) {
    console.error(err);
    res.status(500).json({ response: "Error processing image." });
  } finally {
    fs.unlinkSync(imagePath);
  }
});

app.listen(3000, () => {
  console.log("ZapQ backend running on http://localhost:3000");
});